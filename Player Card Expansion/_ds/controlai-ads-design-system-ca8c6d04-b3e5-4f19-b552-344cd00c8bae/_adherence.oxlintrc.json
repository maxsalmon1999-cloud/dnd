{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/layout/**",
              "components/typography/**",
              "ui_kits/ad-creatives/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Neue Haas Display))/i]",
        "message": "Font not provided by the design system. Available: Neue Haas Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|format|ground|scale|pad|style|className|key|ref|className|style|children)$/]",
        "message": "<AdCanvas> doesn't accept that prop. Declared props: children, format, ground, scale, pad, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdCanvas'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:square|vertical|wide)$/]",
        "message": "<AdCanvas> format must be one of 'square' | 'vertical' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdCanvas'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:halftone|black|ink|terracotta|white|none)$/]",
        "message": "<AdCanvas> ground must be one of 'halftone' | 'black' | 'ink' | 'terracotta' | 'white' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CtaButton> doesn't accept that prop. Declared props: children, variant, size, href, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|parallelogram)$/]",
        "message": "<CtaButton> variant must be one of 'pill' | 'parallelogram'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CtaButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|div)$/]",
        "message": "<CtaButton> as must be one of 'button' | 'a' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|marker|as|style|key|ref|className|style|children)$/]",
        "message": "<EditorialHeadline> doesn't accept that prop. Declared props: children, size, tone, marker, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialHeadline'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|mint|ink)$/]",
        "message": "<EditorialHeadline> tone must be one of 'white' | 'mint' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, variant, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:sub|kicker)$/]",
        "message": "<Eyebrow> variant must be one of 'sub' | 'kicker'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|white|mint|danger)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'white' | 'mint' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|text|size|style|key|ref|className|style|children)$/]",
        "message": "<LogoMark> doesn't accept that prop. Declared props: tone, text, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|dark|light)$/]",
        "message": "<LogoMark> tone must be one of 'mint' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterHeadline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|shadow|italic|as|style|key|ref|className|style|children)$/]",
        "message": "<PosterHeadline> doesn't accept that prop. Declared props: children, size, tone, shadow, italic, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterHeadline'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|danger|mint|ink)$/]",
        "message": "<PosterHeadline> tone must be one of 'white' | 'danger' | 'mint' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterHeadline'] > JSXAttribute[name.name='shadow'] > Literal[value!=/^(?:black|red|none)$/]",
        "message": "<PosterHeadline> shadow must be one of 'black' | 'red' | 'none'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
